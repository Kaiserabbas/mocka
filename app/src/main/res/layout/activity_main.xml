<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mocka"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO v1.1"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_active"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mock Location &amp; Telemetry Provider"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_inactive"
                android:text="● IDLE"
                android:textColor="@color/status_inactive"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Telemetry HUD Card -->
        <LinearLayout
            android:id="@+id/cardTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_highlight"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE BROADCAST TELEMETRY"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btnCopyCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy"
                    android:textColor="@color/accent_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/btn_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="25.204800, 55.270800"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_card"
                android:layout_marginVertical="10dp" />

            <!-- Telemetry Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvLiveSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km/h"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEADING"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvLiveHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0° (N)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALTITUDE"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvLiveAltitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 m"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTANCE"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvLiveDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Coordinates Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COORDINATES &amp; ALTITUDE"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/btnOpenMapPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🗺️ Pick on Map"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🌍 Presets"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/btn_secondary"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⭐ Saved"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:background="@drawable/btn_secondary"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📋"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/btn_secondary"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <!-- Lat and Lon inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latitude (-90 to 90)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/lat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="e.g. 25.1972"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Longitude (-180 to 180)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/lon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="e.g. 55.2744"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Altitude input & quick chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Altitude (meters above sea level)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/alt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="e.g. 15.0"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Altitude Chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/chipMainAlt0"
                        android:layout_width="48dp"
                        android:layout_height="32dp"
                        android:text="0m"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:background="@drawable/btn_secondary"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/chipMainAlt50"
                        android:layout_width="48dp"
                        android:layout_height="32dp"
                        android:text="50m"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:background="@drawable/btn_secondary"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/chipMainAlt250"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:text="250m"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:background="@drawable/btn_secondary" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveBookmark"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="+ Bookmark Current Location &amp; Altitude"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Movement & Speed Simulation Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOVEMENT &amp; SPEED SIMULATION"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <!-- Speed preset chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/chipSpeedStationary"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="0 (Static)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipSpeedWalk"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="5 (Walk)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipSpeedCycle"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="18 (Bike)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipSpeedDrive"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="60 (Drive)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipSpeedHighway"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="110 (Fast)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed (km/h)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="0 = stationary"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="numberDecimal"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heading (0 - 359°)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/bearing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:hint="0 = North"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:inputType="numberDecimal"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Compass Heading Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnHeadingNorth"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="N (0°)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnHeadingEast"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="E (90°)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnHeadingSouth"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="S (180°)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnHeadingWest"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="W (270°)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnTurnMinus"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="-15°"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnTurnPlus"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="+15°"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Natural GPS Jitter / Drift Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Realistic GPS Drift (Jitter)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adds subtle 1-2m atmospheric variance to bypass anti-spoof heuristic checks."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbDrift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:buttonTint="@color/accent_cyan" />
            </LinearLayout>
        </LinearLayout>

        <!-- Directional D-Pad Controls Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DIRECTIONAL D-PAD STEER"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Step Distance selector -->
                <TextView
                    android:id="@+id/tvStepSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step: 50m"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/chipStep10"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="10m"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipStep50"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="50m"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipStep100"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="100m"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/chipStep500"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="500m"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:background="@drawable/btn_secondary" />
            </LinearLayout>

            <!-- D-Pad Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Up / North -->
                <Button
                    android:id="@+id/dpadNorth"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:text="▲ N"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dpad" />

                <!-- Left, Center, Right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="6dp">

                    <Button
                        android:id="@+id/dpadWest"
                        android:layout_width="84dp"
                        android:layout_height="44dp"
                        android:text="◀ W"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dpad"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/dpadCenter"
                        android:layout_width="84dp"
                        android:layout_height="44dp"
                        android:text="● STOP"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dpad"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/dpadEast"
                        android:layout_width="84dp"
                        android:layout_height="44dp"
                        android:text="E ▶"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dpad" />
                </LinearLayout>

                <!-- Down / South -->
                <Button
                    android:id="@+id/dpadSouth"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:text="▼ S"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dpad" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Action Buttons -->
        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Start Spoofing"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnUpdateLive"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Update Live"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Stop Spoofing"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_danger"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Developer Mode Setup Button -->
        <Button
            android:id="@+id/dev"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⚙ Open Developer Options (Select Mock App)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/btn_secondary"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
