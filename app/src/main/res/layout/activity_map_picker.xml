<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Header & Search Bar -->
    <LinearLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:padding="12dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="←"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:background="@drawable/btn_secondary"
                android:padding="0dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select on Interactive Map"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRecenter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎯 Recenter"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:paddingHorizontal="10dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Search Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/editSearchPlace"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Search landmark, city, or address..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSearchPlace"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Search"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map WebView Container -->
    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/mapHeader"
        android:layout_above="@id/bottomCard" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/mapProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/accent_cyan"
        android:visibility="gone" />

    <!-- Bottom Floating Selection HUD Card -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_card_highlight"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SELECTED MAP COORDINATES"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvMapPinTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pan/Zoom map to adjust"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Live Lat / Lon readout -->
        <TextView
            android:id="@+id/tvPickedCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="25.197200, 55.274400"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Altitude (Elevation) Adjustment Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altitude (m):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/editPickedAlt"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_input"
                android:text="15"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="numberSigned|numberDecimal"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <!-- Quick Altitude Chips -->
            <Button
                android:id="@+id/chipAltGround"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="0m"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/chipAltLow"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="50m"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/chipAltHigh"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="250m"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:background="@drawable/btn_secondary" />
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnSaveAsBookmarkFromMap"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="⭐ Bookmark"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnConfirmLocation"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.6"
                android:text="✓ Use This Location"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
